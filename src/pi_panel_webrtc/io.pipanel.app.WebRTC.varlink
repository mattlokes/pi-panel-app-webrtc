# pi-panel-app-webrtc: a full-screen WebRTC camera feed.
#
# Served next to io.pipanel.App on $PI_PANEL_APP_SOCKET. Reach it with
#   pi-panel-ctl app webrtc io.pipanel.app.WebRTC.GetStatus
interface io.pipanel.app.WebRTC

type Camera (
  name: string,
  label: string,
  # "go2rtc:<stream>" or a WHEP URL
  source: string,
  # how the offer is exchanged: go2rtc's WebSocket API, or HTTP (WHEP style)
  signalling: (websocket, http)
)

method ListCameras() -> (cameras: []Camera, current: string)

# Show another camera (connects now if the feed is on screen).
method SelectCamera(name: string) -> ()

method GetStatus() -> (
  camera: string,
  label: string,
  visible: bool,
  state: (idle, connecting, playing, retrying),
  error: ?string,
  width: ?int,
  height: ?int,
  # decoded frames so far in this connection
  frames: int,
  connected_for: ?float,
  retry_in: ?float
)

# Re-read config.toml (as SIGHUP does). On an invalid file the running
# configuration stays in effect and InvalidConfig says why.
method Reload() -> (cameras: []Camera, current: string)

error NoSuchCamera (name: string)
error InvalidConfig (message: string)
